# Development server address. Choose both values explicitly.
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173

# Go API address used by Vite's development proxy.
VITE_BACKEND_URL=http://127.0.0.1:8082

# Keep these empty for development so the browser uses the Vite proxy.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
