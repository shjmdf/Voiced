# Development server address. Choose both values explicitly.
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173

# Go API address used by Vite's development proxy.
VITE_BACKEND_URL=http://127.0.0.1:8082

# Keep these empty for development so the browser uses the Vite proxy.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Optional. Set both files to serve the Vite development frontend over HTTPS.
# Paths are resolved from the frontend directory.
DEV_HTTPS_KEY_FILE=
DEV_HTTPS_CERT_FILE=

# Optional. Used by scripts/start-remote-dev.sh only when it has to create a
# self-signed certificate. Use an IP address or DNS name that browsers use.
DEV_HTTPS_PUBLIC_NAME=

# Optional. A directory containing node and npm, used by the remote dev script.
NODE_BIN_DIR=
