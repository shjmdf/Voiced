# HTTP API and WebSocket address. Use an address appropriate for this machine.
LISTEN_ADDR=127.0.0.1:8082

# Browser origins allowed to call the API and open the WebSocket.
# Separate multiple origins with commas.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional. Set both values to restrict Pion's UDP allocation range.
WEBRTC_UDP_PORT_MIN=40000
WEBRTC_UDP_PORT_MAX=40100

# Optional comma-separated STUN server URLs.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# Optional development endpoint: GET /api/debug/media
VOICED_DEBUG=false
